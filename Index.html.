<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mom's Bakery & Cake Corner</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; background-color: #FDF8F5; }
        .serif { font-family: 'Playfair Display', serif; }
        .glass { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.3); }
        .floating { animation: float 6s ease-in-out infinite; }
        @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }
    </style>
</head>
<body>

    <!-- HERO SECTION -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden px-6">
        <div class="absolute top-20 left-10 floating opacity-30 text-6xl">🍰</div>
        <div class="absolute bottom-20 right-10 floating opacity-30 text-6xl" style="animation-delay: 2s;">☕</div>
        
        <div class="text-center z-10">
            <span class="uppercase tracking-widest text-xs font-bold text-[#D4AF37] mb-4 block">Handcrafted with Love</span>
            <h1 class="serif text-6xl md:text-8xl text-[#3E2723] mb-6">Mom's Bakery <br> <span class="italic font-light text-[#FFD1DC]">& Cake Corner</span></h1>
            <p class="text-gray-600 max-w-lg mx-auto mb-10">Premium custom cakes and refreshing drinks for your special moments.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="https://wa.me/YOURNUMBER" class="bg-[#3E2723] text-white px-10 py-4 rounded-full font-bold shadow-lg hover:bg-black transition">Order on WhatsApp</a>
                <a href="#drinks" class="glass text-[#3E2723] px-10 py-4 rounded-full font-bold hover:bg-white transition">View Drinks</a>
            </div>
        </div>
    </section>

    <!-- CAKE GALLERY (Auto-IG Style) -->
    <section class="py-20 bg-white px-6">
        <h2 class="serif text-4xl text-center text-[#3E2723] mb-12">Signature Cakes</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
            <!-- Item 1 -->
            <div class="rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition">
                <div class="h-80 bg-[#FFD1DC] flex items-center justify-center text-white">Cake Photo</div>
                <div class="p-6">
                    <h3 class="serif text-2xl mb-2">Birthday Special</h3>
                    <p class="text-[#D4AF37] font-bold">$45.00</p>
                </div>
            </div>
            <!-- Item 2 -->
            <div class="rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition">
                <div class="h-80 bg-[#E2F0CB] flex items-center justify-center text-white">Cake Photo</div>
                <div class="p-6">
                    <h3 class="serif text-2xl mb-2">Wedding Tiers</h3>
                    <p class="text-[#D4AF37] font-bold">$120.00</p>
                </div>
            </div>
            <!-- Item 3 -->
            <div class="rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition">
                <div class="h-80 bg-[#FDF8F5] border flex items-center justify-center text-gray-400">Cake Photo</div>
                <div class="p-6">
                    <h3 class="serif text-2xl mb-2">Bento Box Cake</h3>
                    <p class="text-[#D4AF37] font-bold">$15.00</p>
                </div>
            </div>
        </div>
    </section>

    <!-- DRINK SECTION -->
    <section id="drinks" class="py-20 bg-[#F5F9FD] px-6">
        <h2 class="serif text-4xl text-center text-[#3E2723] mb-12">Refreshing Drinks</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            <div class="glass p-6 rounded-[40px] flex items-center gap-6">
                <div class="w-24 h-24 bg-blue-100 rounded-full flex-shrink-0"></div>
                <div>
                    <h4 class="serif text-xl">Iced Rose Latte</h4>
                    <p class="text-gray-500 text-sm">Light & Floral</p>
                    <p class="font-bold mt-1">$6.50</p>
                </div>
            </div>
            <div class="glass p-6 rounded-[40px] flex items-center gap-6">
                <div class="w-24 h-24 bg-pink-100 rounded-full flex-shrink-0"></div>
                <div>
                    <h4 class="serif text-xl">Berry Cooler</h4>
                    <p class="text-gray-500 text-sm">Fresh & Fruity</p>
                    <p class="font-bold mt-1">$5.00</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="py-10 text-center text-gray-400 text-sm">
        <p>© 2026 Mom's Bakery & Cake Corner</p>
        <p class="mt-2 italic">Follow us @momsbakeryandcakecorner</p>
    </footer>

</body>
</html>
